{
  "name": "dsh-plugin-conversation-purge",
  "version": "1.0.1",
  "description": "DSH plugin: permanently delete conversations, optionally together with their documents, attachments and subagent records.",
  "type": "module",
  "license": "MIT",
  "author": "rz-123",
  "homepage": "https://github.com/rz-123/dsh-plugin-conversation-purge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rz-123/dsh-plugin-conversation-purge.git"
  },
  "bugs": {
    "url": "https://github.com/rz-123/dsh-plugin-conversation-purge/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "conversation",
    "purge",
    "delete"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
